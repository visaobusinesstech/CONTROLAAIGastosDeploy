# Vercel (frontend) — Settings → Environment Variables → Production
#
# OBRIGATÓRIO para cadastro/login em controlaai-frontend.vercel.app:
#   BACKEND_URL = URL pública do backend no Railway (ex.: https://xxx.up.railway.app)
#
# Alternativa (chama o Railway direto, sem proxy):
#   VITE_API_URL = mesma URL do Railway
#
# NÃO use controlaai-frontend.vercel.app aqui!
# NÃO use localhost!
#
# Após salvar, faça Redeploy no Vercel.
BACKEND_URL=https://controlaaigastosdeploy.up.railway.app
VITE_API_URL=https://controlaaigastosdeploy.up.railway.app

VITE_APP_URL=https://controlaai-frontend.vercel.app
