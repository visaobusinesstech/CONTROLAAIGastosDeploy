{
  "name": "controla-ai-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "railway:build": "npm run build",
    "db:push": "drizzle-kit push",
    "db:setup": "drizzle-kit push && tsx src/db/seed.ts",
    "db:dbeaver-setup": "node scripts/setup-dbeaver-db.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate:controlaai": "tsx scripts/migrate-to-controlaai.ts",
    "db:migrate:neon-local": "node scripts/migrate-neon-to-local.mjs",
    "db:migrate:railway": "tsx scripts/migrate-to-railway.mjs",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:admin": "tsx src/db/seed-admin.ts",
    "db:seed:rich": "tsx src/db/run-seed-rich-leonardo.ts",
    "db:seed:leonardo": "tsx src/db/run-seed-leonardo-sena.ts",
    "db:migrate:onboarding": "node scripts/run-onboarding-migration.mjs",
    "db:migrate:income": "node scripts/run-income-recurrence-migration.mjs",
    "db:migrate:pay-timing": "node scripts/run-income-pay-timing-migration.mjs",
    "db:migrate:billing": "node scripts/run-billing-migration.mjs",
    "db:migrate:consents": "node scripts/run-user-consents-migration.mjs",
    "db:migrate:auth-email": "node scripts/run-auth-email-migration.mjs",
    "db:migrate:audit-lgpd": "node scripts/run-audit-lgpd-migration.mjs",
    "db:migrate:phone-unique": "node scripts/run-phone-unique-migration.mjs",
    "db:migrate:all": "node scripts/run-all-migrations.mjs",
    "db:migrate:income-type": "node scripts/run-income-type-migration.mjs",
    "db:export-tcc": "node scripts/export-tcc-database.mjs",
    "tcc:architecture-png": "node scripts/generate-database-architecture-png.mjs",
    "tcc:architecture-full": "node scripts/generate-database-architecture-full.mjs",
    "tcc:pdf": "node scripts/generate-tcc-pdf.mjs",
    "tcc:txt": "node scripts/generate-tcc-txt.mjs",
    "tcc:docs": "node scripts/generate-tcc-txt.mjs && node scripts/generate-tcc-pdf.mjs",
    "tcc:banco-pdf": "node scripts/generate-banco-completo-pdf.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "bcryptjs": "^2.4.3",
    "controla-ai": "file:..",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "postgres": "^3.4.5",
    "stripe": "^17.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pdf-parse": "^1.1.4",
    "drizzle-kit": "^0.30.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "md-to-pdf": "^5.2.5",
    "puppeteer": "^23.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
