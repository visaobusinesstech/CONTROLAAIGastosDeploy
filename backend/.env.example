# =============================================================================
# PRODUÇÃO (Railway) — DATABASE_URL do Postgres Railway (rlwy.net)
# =============================================================================
DATABASE_URL=postgresql://postgres:SENHA@xxxx.proxy.rlwy.net:PORTA/railway?sslmode=require

# Opcional: banco local antigo (só para script migrate-to-railway.mjs)
# LOCAL_DATABASE_URL=postgresql://controlaai:controlaai123@localhost:5432/controlaai

JWT_SECRET=change_me_to_a_long_random_string
PORT=3333
FRONTEND_URL=http://localhost:5179
NODE_ENV=development

# E-mail transacional (reset de senha + códigos 2FA)
# Produção: SMTP Gmail (padrão no mailer). SMTP_PASS no Railway sobrescreve a senha de app.
# Resend (opcional): beth.t@example.com só entrega para o e-mail da conta Resend.
RESEND_API_KEY=
MAIL_FROM=Controla.ai <beth.t@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=controlaisistematech@gmail.com
SMTP_PASS=
MAIL_FROM_SMTP=Controla.ai <controlaisistematech@gmail.com>

# Relay SMTP Vercel (Railway bloqueia 465/587 — POST HTTPS com SMTP_USER/PASS no body)
# Vercel: só EMAIL_SMTP_RELAY_SECRET. Railway: URL + secret + SMTP_* abaixo.
EMAIL_SMTP_RELAY_URL=https://controlaai-frontend.vercel.app/api/email-relay
EMAIL_SMTP_RELAY_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
ENABLE_WHATSAPP=true
REGISTER_URL=https://controlaai-frontend.vercel.app/register
BAILEYS_SESSION_DIR=./.baileys-session
WHATSAPP_KEEPALIVE_INTERVAL_MS=1800000

# Stripe — assinaturas Controla.ai Pro (live)
# Configure no Railway / .env local (Dashboard Stripe → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_BRANDING_LOGO_FILE_ID=
STRIPE_BRANDING_ICON_FILE_ID=
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_YEARLY=
PUBLIC_DASHBOARD_URL=https://controlaai-frontend.vercel.app

# =============================================================================
# RAILWAY (produção) — NÃO use localhost! Cole nas Variables do serviço backend
# =============================================================================
# 1. Railway → projeto → New → Database → PostgreSQL
# 2. Clique no Postgres → Connect → copie DATABASE_URL (interna ou pública)
#    Interna (backend no mesmo projeto): postgresql://postgres:xxx@postgres.railway.internal:5432/railway
#    Pública (DBeaver): postgresql://postgres:xxx@xxxx.proxy.rlwy.net:12345/railway
# 3. Variables do serviço BACKEND:
#    DATABASE_URL = (URL do passo 2 — NUNCA localhost)
#    JWT_SECRET = string longa aleatória
#    FRONTEND_URL = https://controlaai-frontend.vercel.app
#    NODE_ENV = production
#    OPENAI_API_KEY = sk-...
#    ENABLE_WHATSAPP = true
#    STRIPE_SECRET_KEY = (chave secreta ou restricted do Stripe)
#    STRIPE_WEBHOOK_SECRET = (webhook /webhooks/stripe)
#    STRIPE_PRICE_MONTHLY = price_...
#    STRIPE_PRICE_YEARLY = price_...
#    PUBLIC_DASHBOARD_URL = https://controlaai-frontend.vercel.app
#    RESEND_API_KEY = re_...  (e-mails de reset e 2FA)
#    MAIL_FROM = Controla.ai <beth.t@example.com>
# 4. Rode o schema no Postgres Railway (DBeaver na URL pública):
#    drizzle/01-dbeaver-create-db.sql (ajuste user se necessário)
#    drizzle/0000_full_schema.sql
#    npm run db:seed (local apontando para URL Railway, ou SQL manual)
