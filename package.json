{
  "name": "controla-ai",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:push": "npm run db:push --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:setup": "npm run db:setup --prefix backend",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "git:push": "powershell -ExecutionPolicy Bypass -File scripts/git-push.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
