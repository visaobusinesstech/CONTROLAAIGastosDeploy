# Produção: browser usa same-origin (/auth, /api) → middleware Vercel → BACKEND_URL.
# NÃO coloque a URL do Railway em VITE_API_URL (fica bake no build e quebra se o serviço mudar).
# No Vercel (opcional): BACKEND_URL = https://controlaaigastosdeploy-production.up.railway.app
# Sem BACKEND_URL, middleware/proxy usam esse host como DEFAULT_BACKEND_URL.
VITE_API_URL=
