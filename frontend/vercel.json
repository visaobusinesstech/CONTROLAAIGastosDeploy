{
  "rewrites": [
    { "source": "/auth/forgot", "destination": "/api/auth?path=forgot" },
    { "source": "/auth/reset", "destination": "/api/auth?path=reset" },
    { "source": "/auth/login", "destination": "/api/auth?path=login" },
    { "source": "/auth/me", "destination": "/api/auth?path=me" },
    { "source": "/auth/2fa/enable", "destination": "/api/auth?path=2fa/enable" },
    { "source": "/auth/2fa/disable", "destination": "/api/auth?path=2fa/disable" },
    { "source": "/auth/2fa/verify", "destination": "/api/auth?path=2fa/verify" },
    { "source": "/auth/2fa/resend", "destination": "/api/auth?path=2fa/resend" },
    { "source": "/auth/:path*", "destination": "/api/backend-proxy/auth/:path*" },
    { "source": "/relay/send", "destination": "/api/relay/send" },
    { "source": "/api/settings", "destination": "/api/user-settings" },
    {
      "source": "/api/((?!auth(?:$|\\?)|backend-proxy|relay|user-settings|settings).*)",
      "destination": "/api/backend-proxy/api/$1"
    },
    { "source": "/health", "destination": "/api/backend-proxy/health" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
