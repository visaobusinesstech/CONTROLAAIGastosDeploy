# Vercel (frontend) — Settings → Environment Variables → Production
#
# OBRIGATÓRIO (runtime do proxy Edge):
#   BACKEND_URL = URL pública do backend no Railway
#   Ex.: https://seu-servico.up.railway.app
#
# Deixe VITE_API_URL vazio em produção — o browser chama o mesmo domínio
# (controlaai-frontend.vercel.app/auth/...) e o middleware encaminha ao Railway.
#
# NÃO use controlaai-frontend.vercel.app aqui!
# NÃO use localhost!
# NÃO use URLs antigas (controlaaigastosdeploy / backend-production-c328) — estão 404.
#
# Após salvar BACKEND_URL, faça Redeploy no Vercel.
BACKEND_URL=https://SEU-SERVICO.up.railway.app
VITE_API_URL=

VITE_APP_URL=https://controlaai-frontend.vercel.app

# Relay SMTP (Node) — secret igual ao Railway + SMTP Gmail (fallback se o body não trouxer)
EMAIL_SMTP_RELAY_SECRET=
SMTP_USER=controlaisistematech@gmail.com
SMTP_PASS=
MAIL_FROM_SMTP=Controla.ai <controlaisistematech@gmail.com>
