# =============================================================================
# PRODUÇÃO (Railway) — DATABASE_URL do Postgres Railway (rlwy.net)
# =============================================================================
# Preferir URL INTERNA no serviço backend (mesmo projeto):
#   postgresql://postgres:SENHA@postgres.railway.internal:5432/railway
# URL pública (migrações do PC / DBeaver):
#   postgresql://postgres:SENHA@xxxx.proxy.rlwy.net:PORTA/railway?sslmode=require
DATABASE_URL=postgresql://postgres:SENHA@xxxx.proxy.rlwy.net:PORTA/railway?sslmode=require

JWT_SECRET=change_me_to_a_long_random_string
PORT=3333
FRONTEND_URL=https://controlaai-frontend.vercel.app
NODE_ENV=production

# E-mail (Gmail senha de app) — esqueci senha + 2FA opt-in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=controlaisistematech@gmail.com
SMTP_PASS=
MAIL_FROM_SMTP=Controla.ai <controlaisistematech@gmail.com>

# Railway costuma bloquear SMTP direto — use o relay Vercel + secret compartilhado
EMAIL_SMTP_RELAY_URL=https://controlaai-frontend.vercel.app/relay/send
EMAIL_SMTP_RELAY_SECRET=

# Resend (opcional, fallback)
RESEND_API_KEY=
MAIL_FROM=Controla.ai <noreply@controlaai.com>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
ENABLE_WHATSAPP=true
REGISTER_URL=https://controlaai-frontend.vercel.app/register
BAILEYS_SESSION_DIR=./.baileys-session
WHATSAPP_KEEPALIVE_INTERVAL_MS=1800000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_BRANDING_LOGO_FILE_ID=
STRIPE_BRANDING_ICON_FILE_ID=
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_YEARLY=
PUBLIC_DASHBOARD_URL=https://controlaai-frontend.vercel.app
